{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "content.schema.json",
  "title": "Content",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "vertical", "sections", "reuse_facts"],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "vertical": {
      "type": "string",
      "minLength": 1
    },
    "sections": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hero", "benefits", "social_proof", "contact"],
      "properties": {
        "hero": {
          "type": "object",
          "additionalProperties": false,
          "required": ["headline", "subheadline", "cta"],
          "properties": {
            "headline": { "type": "string", "minLength": 1 },
            "subheadline": { "type": "string", "minLength": 1 },
            "cta": { "type": "string", "minLength": 1 }
          }
        },
        "benefits": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["title", "text"],
            "properties": {
              "title": { "type": "string", "minLength": 1 },
              "text": { "type": "string", "minLength": 1 }
            }
          }
        },
        "social_proof": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "reviews": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            },
            "cases": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            }
          }
        },
        "contact": {
          "type": "object",
          "additionalProperties": false,
          "required": ["phone", "cta"],
          "properties": {
            "phone": { "type": "string", "minLength": 1 },
            "cta": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "reuse_facts": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
