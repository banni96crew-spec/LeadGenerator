{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "content.schema.json",
  "title": "Content",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "vertical",
    "sections",
    "footer_tagline",
    "reuse_facts"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "vertical": {
      "type": "string",
      "minLength": 1
    },
    "footer_tagline": {
      "type": "string",
      "minLength": 1
    },
    "sections": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hero", "proof", "approach", "projects", "materials"],
      "properties": {
        "hero": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "headline",
            "subheadline",
            "cta_primary",
            "cta_secondary"
          ],
          "properties": {
            "headline": { "type": "string", "minLength": 1 },
            "subheadline": { "type": "string", "minLength": 1 },
            "cta_primary": { "type": "string", "minLength": 1 },
            "cta_secondary": { "type": "string", "minLength": 1 }
          }
        },
        "proof": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["value", "label"],
            "properties": {
              "value": { "type": "string", "minLength": 1, "maxLength": 12 },
              "label": { "type": "string", "minLength": 1 }
            }
          }
        },
        "approach": {
          "type": "object",
          "additionalProperties": false,
          "required": ["eyebrow", "h2", "prose", "steps"],
          "properties": {
            "eyebrow": { "type": "string", "minLength": 1 },
            "h2": { "type": "string", "minLength": 1 },
            "prose": { "type": "string", "minLength": 1 },
            "steps": {
              "type": "array",
              "minItems": 4,
              "maxItems": 4,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["title", "text"],
                "properties": {
                  "title": { "type": "string", "minLength": 1 },
                  "text": { "type": "string", "minLength": 1 }
                }
              }
            }
          }
        },
        "projects": {
          "type": "object",
          "additionalProperties": false,
          "required": ["eyebrow", "h2", "lead", "items"],
          "properties": {
            "eyebrow": { "type": "string", "minLength": 1 },
            "h2": { "type": "string", "minLength": 1 },
            "lead": { "type": "string", "minLength": 1 },
            "items": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["title", "text"],
                "properties": {
                  "title": { "type": "string", "minLength": 1 },
                  "text": { "type": "string", "minLength": 1 }
                }
              }
            }
          }
        },
        "materials": {
          "type": "object",
          "additionalProperties": false,
          "required": ["eyebrow", "h2", "prose", "items"],
          "properties": {
            "eyebrow": { "type": "string", "minLength": 1 },
            "h2": { "type": "string", "minLength": 1 },
            "prose": { "type": "string", "minLength": 1 },
            "items": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "reuse_facts": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
