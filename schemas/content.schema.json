{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "content.schema.json",
  "title": "Content",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "vertical", "sections", "reuse_facts"],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "vertical": {
      "type": "string",
      "minLength": 1
    },
    "sections": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hero", "trust", "symptoms", "why_us", "contact"],
      "properties": {
        "hero": {
          "type": "object",
          "additionalProperties": false,
          "required": ["eyebrow", "headline", "subheadline", "cta"],
          "properties": {
            "eyebrow": { "type": "string", "minLength": 1 },
            "headline": { "type": "string", "minLength": 1 },
            "subheadline": { "type": "string", "minLength": 1 },
            "cta": { "type": "string", "minLength": 1 }
          }
        },
        "trust": {
          "type": "array",
          "minItems": 3,
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["title", "text"],
            "properties": {
              "title": { "type": "string", "minLength": 1 },
              "text": { "type": "string", "minLength": 1 }
            }
          }
        },
        "symptoms": {
          "type": "array",
          "minItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["pain", "solve"],
            "properties": {
              "pain": { "type": "string", "minLength": 1 },
              "solve": { "type": "string", "minLength": 1 }
            }
          }
        },
        "why_us": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["title", "text"],
            "properties": {
              "title": { "type": "string", "minLength": 1 },
              "text": { "type": "string", "minLength": 1 }
            }
          }
        },
        "contact": {
          "type": "object",
          "additionalProperties": false,
          "required": ["phone", "cta"],
          "properties": {
            "phone": { "type": "string", "minLength": 1 },
            "cta": { "type": "string", "minLength": 1 },
            "phone_digits": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "reuse_facts": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
