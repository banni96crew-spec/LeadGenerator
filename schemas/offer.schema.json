{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "offer.schema.json",
  "title": "Offer",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "message",
    "usp",
    "why_this_company",
    "links"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "message": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1500
    },
    "usp": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "why_this_company": {
      "type": "string",
      "minLength": 1
    },
    "links": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "demo",
        "portfolio",
        "audit_pdf"
      ],
      "properties": {
        "demo": {
          "type": "string",
          "minLength": 1
        },
        "portfolio": {
          "type": "string",
          "minLength": 1
        },
        "audit_pdf": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
