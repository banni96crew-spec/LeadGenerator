{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "audit.schema.json",
  "title": "Audit",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "lead_id",
    "business_facts",
    "findings",
    "money_loss_summary"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "lead_id": {
      "type": "string",
      "minLength": 1
    },
    "business_facts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["services", "usp_existing", "audience"],
      "properties": {
        "services": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "usp_existing": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "audience": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "findings": {
      "type": "array",
      "minItems": 3,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "category", "claim", "evidence", "impact", "severity"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "type": "string",
            "enum": [
              "доверие",
              "дизайн",
              "мобильная",
              "производительность",
              "конверсия",
              "контент",
              "контакт",
              "seo_visibility"
            ]
          },
          "claim": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "string",
            "minLength": 1,
            "anyOf": [
              { "pattern": "^capture/(desktop|mobile)\\.png$" },
              { "pattern": "^capture/text\\.txt#L[1-9]\\d*-L[1-9]\\d*$" }
            ]
          },
          "impact": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "type": "string",
            "enum": ["high", "medium", "low"]
          }
        }
      }
    },
    "money_loss_summary": {
      "type": "string",
      "minLength": 1
    },
    "tone": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[^\\n\\r]+$"
    }
  }
}
