{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "capture-meta.schema.json",
  "title": "CaptureMeta",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "url",
    "http_status",
    "screenshots",
    "extracted_text",
    "assets",
    "signals"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "url": { "type": "string", "format": "uri" },
    "http_status": { "type": "integer" },
    "screenshots": {
      "type": "object",
      "additionalProperties": false,
      "required": ["desktop", "mobile"],
      "properties": {
        "desktop": { "type": "string", "minLength": 1 },
        "mobile": { "type": "string", "minLength": 1 }
      }
    },
    "extracted_text": { "type": "string", "minLength": 1 },
    "assets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["photos"],
      "properties": {
        "logo": { "type": "string" },
        "photos": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "signals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["https", "mobile_friendly", "has_cta", "has_form"],
      "properties": {
        "https": { "type": "boolean" },
        "mobile_friendly": { "type": "boolean" },
        "has_cta": { "type": "boolean" },
        "has_form": { "type": "boolean" },
        "tech": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "lcp_ms": { "type": "number", "minimum": 0 }
      }
    }
  }
}
