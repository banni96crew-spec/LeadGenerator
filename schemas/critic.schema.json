{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "critic.schema.json",
  "title": "DesignCritic",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "pass", "scores", "notes"],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "pass": {
      "type": "boolean"
    },
    "gate": {
      "type": "string",
      "const": "G4"
    },
    "scores": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trust", "modern", "sellable", "readable"],
      "properties": {
        "trust": { "type": "integer", "minimum": 1, "maximum": 5 },
        "modern": { "type": "integer", "minimum": 1, "maximum": 5 },
        "sellable": { "type": "integer", "minimum": 1, "maximum": 5 },
        "readable": { "type": "integer", "minimum": 1, "maximum": 5 }
      }
    },
    "notes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
