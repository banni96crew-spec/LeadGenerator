{
  "name": "leadgenerator",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "pipeline": "tsx src/orchestrator/index.ts",
    "capture": "tsx src/orchestrator/index.ts -- --stage capture",
    "audit": "tsx src/orchestrator/index.ts -- --stage audit",
    "copy": "tsx src/orchestrator/index.ts -- --stage copy",
    "design": "tsx src/orchestrator/index.ts -- --stage design",
    "validate-schemas": "tsx src/scripts/validate-schemas.ts",
    "smoke": "tsx src/scripts/smoke.ts",
    "test": "tsx --test src/**/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "image-size": "^1.2.0",
    "playwright": "^1.49.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
