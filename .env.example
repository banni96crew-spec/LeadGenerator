# Cloudflare Pages — Publish step (milestone 4). Copy to .env locally; never commit .env.
# Account ID from dashboard URL: https://dash.cloudflare.com/<ACCOUNT_ID>/...

CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token

# One Pages project for all lead demos (PRD §17: subpaths /{lead_id} recommended)
CLOUDFLARE_PAGES_PROJECT=leadgenerator-demos
