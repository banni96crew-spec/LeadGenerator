# Cloudflare Pages — Publish step (milestone 4). Copy to .env locally; never commit .env.
# Account ID from dashboard URL: https://dash.cloudflare.com/<ACCOUNT_ID>/...
# Token scopes: Cloudflare Pages Edit + Account Settings Read.

CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token

# One Pages project. M4 = branch-per-lead (NOT subpath):
#   wrangler pages deploy … --branch={lead_id}
#   demo_url is parsed from wrangler output (alias URL preferred).
#   Note: CF Pages subdomain may differ from project name
#   (e.g. project leadgenerator → *.leadgenerator-7sp.pages.dev).
# PRD §17 subpath /{lead_id} is deferred (needs Design <base href>) — do not use in M4.
CLOUDFLARE_PAGES_PROJECT=leadgenerator-demos

# Gate G5 Lighthouse performance minimum (0–100). Required for M4 smoke — no skip stub.
LIGHTHOUSE_PERF_MIN=85
